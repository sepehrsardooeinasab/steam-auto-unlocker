#!/usr/bin/env bash
# Convenience launcher for the Steam achievement unlocker.
set -euo pipefail

PROJECT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
JSONS_DIR="$PROJECT_DIR/jsons"
ASF_DIR="$PROJECT_DIR/archifarm"
ASF_BINARY="$ASF_DIR/ArchiSteamFarm"

show_help() {
    cat <<'EOF'
Usage: runsteamunlocker [-f] [-w | -in <time>] <config-name>
       runsteamunlocker -t <config-name>
       runsteamunlocker [-h | -a | -ls | -c | -j | -k]

  <config-name>   Run the unlocker using jsons/config_<config-name>.json.
                  Shows the upcoming session's length and asks to confirm.
  -f, --force     Same as above, but skip the confirmation prompt.
  -w, --wait      Confirm now, then wait (under caffeinate, without
                  touching ASF) until the session can run, and start it.
  -in <time>      Confirm now, then wait <time> before starting, e.g.
                  30 (minutes), 45m, 2h, 1h30m. Refused if the session's
                  cooldown would still be running by then.
  -t, --time      Print "<wait_seconds> <duration_seconds>" for the next
                  session and exit, without running or touching ASF.
  -k, --kill      Stop ArchiSteamFarm and any running unlocker session.
  -h, --help      Show this help.
  -a              List available jsons/config_*.json profiles.
  -ls, --status   List every profile's next session (number, length,
                  achievement count) and when it can run, without
                  running anything or touching ASF.
  -c              Open the project in VS Code.
  -j              Open the JSON/unlock scheduler builder.
EOF
}

open_file() {
    if [ "$(uname -s)" = "Darwin" ]; then
        open "$1"
    else
        xdg-open "$1"
    fi
}

list_configs() {
    local f name
    for f in "$JSONS_DIR"/config_*.json; do
        [ -e "$f" ] || continue
        name="$(basename "$f")"
        name="${name#config_}"
        name="${name%.json}"
        echo "$name"
    done
}

kill_all() {
    local found=0
    if pgrep -f "$ASF_BINARY" > /dev/null 2>&1; then
        echo "Stopping ArchiSteamFarm..."
        pkill -f "$ASF_BINARY"
        found=1
    fi
    if pgrep -f "$PROJECT_DIR/unlocker/run_unlocker.py" > /dev/null 2>&1; then
        echo "Stopping running unlocker session..."
        pkill -f "$PROJECT_DIR/unlocker/run_unlocker.py"
        found=1
    fi
    if [ "$found" -eq 0 ]; then
        echo "Nothing running."
    fi
}

force=0
time_only=0
wait_ready=0
delay=""
while [ "$#" -gt 0 ]; do
    case "$1" in
        -f|--force) force=1; shift ;;
        -t|--time) time_only=1; shift ;;
        -w|--wait) wait_ready=1; shift ;;
        -in|--in)
            if [ "$#" -lt 2 ]; then
                echo "-in needs a time, e.g. 30, 45m, 2h, 1h30m" >&2
                exit 1
            fi
            delay="$2"
            if ! [[ "$delay" =~ ^([0-9]+|([0-9]+h)?([0-9]+m)?([0-9]+s)?)$ ]] || [ -z "$delay" ]; then
                echo "-in needs a time, e.g. 30, 45m, 2h, 1h30m (got '$delay')" >&2
                exit 1
            fi
            shift 2
            ;;
        *) break ;;
    esac
done

if [ "$wait_ready" -eq 1 ] && [ -n "$delay" ]; then
    echo "Use either -w or -in, not both." >&2
    exit 1
fi
if [ "$time_only" -eq 1 ] && { [ "$force" -eq 1 ] || [ "$wait_ready" -eq 1 ] || [ -n "$delay" ]; }; then
    echo "-t can't be combined with -f, -w or -in." >&2
    exit 1
fi

if [ "$#" -gt 1 ]; then
    echo "Unexpected extra argument(s): ${*:2}" >&2
    show_help
    exit 1
fi

case "${1-}" in
    -h|--help|"")
        show_help
        ;;
    --list-configs)
        list_configs
        ;;
    -a)
        list_configs
        ;;
    -ls|--status)
        exec python3 "$PROJECT_DIR/unlocker/run_unlocker.py" --status
        ;;
    -c)
        code "$PROJECT_DIR"
        ;;
    -j)
        open_file "$PROJECT_DIR/docs/index.html"
        ;;
    -k|--kill)
        kill_all
        ;;
    -*)
        echo "Unknown option: $1" >&2
        show_help
        exit 1
        ;;
    *)
        name="$1"
        config_path="$JSONS_DIR/config_${name}.json"
        if [ ! -f "$config_path" ]; then
            echo "No such config: $config_path" >&2
            echo "Available: $(list_configs | tr '\n' ' ')" >&2
            exit 1
        fi
        py_args=("$name")
        [ "$time_only" -eq 1 ] && py_args+=(--time)
        [ "$force" -eq 1 ] && py_args+=(--force)
        [ "$wait_ready" -eq 1 ] && py_args+=(--wait)
        [ -n "$delay" ] && py_args+=(--in "$delay")
        exec python3 "$PROJECT_DIR/unlocker/run_unlocker.py" "${py_args[@]}"
        ;;
esac