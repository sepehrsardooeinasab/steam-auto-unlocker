#!/usr/bin/env bash
# Convenience launcher for the Steam achievement unlocker.
set -euo pipefail

PROJECT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
JSONS_DIR="$PROJECT_DIR/jsons"
ASF_DIR="$PROJECT_DIR/archifarm"
ASF_BINARY="$ASF_DIR/ArchiSteamFarm"
ASF_LOG="$ASF_DIR/log.txt"

show_help() {
    cat <<'EOF'
Usage: runsteamunlocker [<config-name> | -h | -a | -c | -j]

  <config-name>   Run the unlocker using jsons/config_<config-name>.json.
  -h, --help      Show this help.
  -a              List available jsons/config_*.json profiles.
  -c              Open the project in VS Code.
  -j              Open the JSON/unlock scheduler builder.

Tab-complete <config-name> to see available jsons/config_*.json profiles.
EOF
}

list_configs() {
    local f name
    for f in "$JSONS_DIR"/config_*.json; do
        [ -e "$f" ] || continue
        name="$(basename "$f")"
        name="${name#config_}"
        name="${name%.json}"
        echo "$name"
    done
}

ensure_asf_running() {
    if pgrep -f "$ASF_BINARY" > /dev/null 2>&1; then
        return
    fi
    echo "ArchiSteamFarm isn't running, starting it..."
    (cd "$ASF_DIR" && nohup "$ASF_BINARY" >> "$ASF_LOG" 2>&1 &)
    sleep 5
}

if [ "$#" -gt 1 ]; then
    echo "Unexpected extra argument(s): ${*:2}" >&2
    show_help
    exit 1
fi

case "${1-}" in
    -h|--help|"")
        show_help
        ;;
    --list-configs)
        list_configs
        ;;
    -a)
        list_configs
        ;;
    -c)
        code "$PROJECT_DIR"
        ;;
    -j)
        open "$PROJECT_DIR/docs/index.html"
        ;;
    -*)
        echo "Unknown option: $1" >&2
        show_help
        exit 1
        ;;
    *)
        name="$1"
        config_path="$JSONS_DIR/config_${name}.json"
        if [ ! -f "$config_path" ]; then
            echo "No such config: $config_path" >&2
            echo "Available: $(list_configs | tr '\n' ' ')" >&2
            exit 1
        fi
        ensure_asf_running
        exec python3 "$PROJECT_DIR/unlocker/run_unlocker.py" "$name"
        ;;
esac
